{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "target": "ES2022",
    "noEmit": true,
    "baseUrl": "./src",
    "paths": {
      "@core/*": ["core/*"],
      "@btps/sdk/client": ["client/index.ts"],
      "@btps/sdk/server": ["server/index.ts"]
    },
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "isolatedModules": true
  },
  "include": ["src", "packages/boundview/src", "**/*.test.ts", "**/*.spec.ts"],
  "exclude": ["node_modules", "dist", "examples"]
}
