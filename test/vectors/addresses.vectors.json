      "reason": "empty domain"
    },
    {
      "input": "alice@example.com",
      "reason": "no separator"
    },
    {
      "input": "alice$localhost",
      "reason": "a single label"
    },
    {
      "input": "alice$-bad.example",
      "reason": "a label starting with \"-\""
    },
    {
      "input": "alice$bad-.example",
      "reason": "a label ending with \"-\""
    },
    {
      "input": "alice$ex_ample.com",
      "reason": "\"_\" in the domain"
    },
    {
