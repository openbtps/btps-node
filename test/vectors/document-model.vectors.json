    {
      "name": "non-canonical-base64-refused",
      "document": "invoice.v2.json",
      "setPath": [
        { "path": ["attachments", 0, "content"], "value": "QR==" },
        { "path": ["attachments", 0, "size"], "value": 1 },
        { "path": ["attachments", 0, "sha256"], "value": "559aead08264d5795d3909718cdd05abd49572e84fe55590eef31a88a08fdffd" }
      ],
      "expect": { "reject": "content" }
    },
    {
      "name": "second-attachment-at-fault",
      "document": "invoice.replaces.v2.json",
      "setPath": [
        { "path": ["attachments", 1, "size"], "value": 68 }
      ],
      "expect": { "reject": "size", "index": 1 }
