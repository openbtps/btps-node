  "taxTotal": [
    {
      "name": "invoice-two-rates",
      "document": "invoice.v2.json",
      "expect": {
        "ok": true,
        "computedTotal": { "amount": 170000, "currency": "AUD" },
        "byCategory": { "GST10": 15000, "GST0": 0 }
      }
    },
    {
      "name": "credit-note-one-rate",
      "document": "credit-note.v2.json",
      "expect": {
        "ok": true,
        "computedTotal": { "amount": 20000, "currency": "AUD" },
        "byCategory": { "GST10": 2000 }
      }
    },
    {
      "name": "invoice-total-disagrees",
      "document": "invoice.v2.json",
      "set": { "total": { "amount": 999, "currency": "AUD" } },
      "expect": {
        "ok": false,
        "computedTotal": { "amount": 170000, "currency": "AUD" },
        "byCategory": { "GST10": 15000, "GST0": 0 }
      }
    },
    {
      "name": "invoice-one-rate-disagrees",
      "document": "invoice.v2.json",
      "set": {
        "taxTotals": [
          { "taxCategory": "GST10", "amount": { "amount": 999, "currency": "AUD" } },
          { "taxCategory": "GST0", "amount": { "amount": 0, "currency": "AUD" } }
        ]
      },
      "expect": {
        "ok": false,
        "computedTotal": { "amount": 170000, "currency": "AUD" },
        "byCategory": { "GST10": 15000, "GST0": 0 }
      }
