      "expect": { "reject": "size" }
    },
    {
      "name": "hash-mismatch-refused",
      "document": "invoice.v2.json",
      "setPath": [
        { "path": ["attachments", 0, "sha256"], "value": "9853e99cb7e9817f7ee8b6fb9ade7c8e023d2520647034a098f7f85ed81e9cb0" }
      ],
      "expect": { "reject": "sha256" }
    },
    {
      "name": "content-swapped-for-another-file-refused",
      "document": "invoice.v2.json",
      "setPath": [
        { "path": ["attachments", 0, "content"], "value": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAIAAACQd1PeAAAADElEQVR42mP4//8/AAX+Av4zEpUUAAAAAElFTkSuQmCC" },
        { "path": ["attachments", 0, "size"], "value": 69 }
      ],
