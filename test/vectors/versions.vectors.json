{
  "description": "A 1.2 implementation speaks 1.1 and 1.2: it takes every artifact stamped 1.1.x or 1.2.x and refuses any other version (BTP_ERROR_VERSION_UNSUPPORTED), compared by major and minor. It stamps an artifact 1.1.0 when everything in it can be said in 1.1, and 1.2.0 only when it uses something 1.2 adds, so a 1.1 receiver takes every artifact a 1.1 sender could have sent. `stamped` gives each artifact before it is signed (an encrypted one by its envelope) and the version it is stamped with.",
  "supported": [
    {
      "version": "1.1.0",
      "expect": "accept"
    },
    {
      "version": "1.1.9",
      "expect": "accept"
    },
    {
      "version": "1.2.0",
      "expect": "accept"
    },
    {
      "version": "1.2.4",
      "expect": "accept"
    },
    {
      "version": "1.0.0",
      "expect": "refuse"
    },
    {
      "version": "1.3.0",
      "expect": "refuse"
    },
    {
      "version": "2.2.0",
      "expect": "refuse"
    },
    {
      "version": "v1.2.0",
      "expect": "refuse"
    },
    {
      "version": "",
      "expect": "refuse"
    }
  ],
